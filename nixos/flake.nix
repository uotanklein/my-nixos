{
  description = "Personal NixOS desktop migrated from CachyOS on 2026-10-21";

  inputs = {
    # A fixed revision with Hyprland 0.56.2 and its Lua configuration API.
    nixpkgs.url = "github:NixOS/nixpkgs/02c087f3fe673c9e317f206a627cb6b910336dbe";
    caelestia = {
      url = "github:caelestia-dots/shell/d999d4878ee4cec134168e60d913714566a8cfa6";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = inputs@{ nixpkgs, ... }: {
    nixosConfigurations.desktop = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      specialArgs = {
        inherit inputs;
        migrationUser = (builtins.fromJSON (builtins.readFile ./user.json)).username;
      };
      modules = [
        # The REAL configuration generated by the new NixOS installation.
        # In particular: disk UUIDs, boot loader, password and system.stateVersion.
        ./configuration.nix
        ./desktop.nix
      ];
    };
  };
}

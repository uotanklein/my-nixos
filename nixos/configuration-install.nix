# Template used ONLY by install-from-iso.sh for a fresh UEFI installation.
# The placeholders are replaced from the generated installation configuration.
{ ... }: {
  imports = [ ./hardware-configuration.nix ];
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi = {
    canTouchEfiVariables = true;
    efiSysMountPoint = "/boot";
  };
  users.users."@USERNAME@" = {
    isNormalUser = true;
    uid = 1000;
    group = "users";
    extraGroups = [ "wheel" "networkmanager" ];
  };
  # This must match the version generated by the installation ISO, not the
  # package collection version and not CachyOS. Do not change it on upgrades.
  system.stateVersion = "@STATE_VERSION@";
}
